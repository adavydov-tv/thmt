
# ---------------------------------------------------------------------------
#  Аутентификация (Google OIDC) и роли
#  Google Cloud Console → OAuth consent screen (Internal) → Credentials →
#  OAuth client ID (Web): redirect URI = <AUTH_PUBLIC_URL>/auth/callback.
#  Роли: viewer (чтение), lead (своё поддерево HRDB), supervisor (всё, кроме
#  AI/удаления/общих настроек), administrator. Управление — в общих настройках.
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_PUBLIC_URL=http://localhost:8080
AUTH_ALLOWED_DOMAIN=tradingview.com
# Случайная строка 32+ символов: openssl rand -base64 32
AUTH_COOKIE_SECRET=
# Первые администраторы (bootstrap), дальше роли раздаются в UI.
ADMIN_EMAILS=adavydov@tradingview.com
AUTH_SESSION_TTL=12h
