# ============================================================================
#  user-activity-dashboard — все секреты и настройки
#  Скопируйте в .env и заполните:  cp .env.example .env
#  Файл .env в .gitignore — не коммитьте его.
# ============================================================================

# ---------------------------------------------------------------------------
#  Сервер
# ---------------------------------------------------------------------------
SERVER_ADDR=:8080
# Origin'ы для CORS в dev-режиме (Vite поднимается на 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Каталог со сборкой фронтенда; если его нет — сервис отдаёт только API
STATIC_DIR=web/dist
LOG_LEVEL=info

# ---------------------------------------------------------------------------
#  PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgres://activity:activity@localhost:5432/activity?sslmode=disable
POSTGRES_MAX_CONNS=8
POSTGRES_MIGRATE_ON_START=true
POSTGRES_CONNECT_TIMEOUT=10s

# ---------------------------------------------------------------------------
#  Jira Cloud
#  Токен: https://id.atlassian.com/manage-profile/security/api-tokens
#  Авторизация — Basic (email + API token), REST API v3.
# ---------------------------------------------------------------------------
JIRA_ENABLED=true
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# Ограничить сбор проектами (через запятую), пусто — все доступные
JIRA_PROJECTS=
JIRA_PAGE_SIZE=100
# История переходов статусов (дороже по числу запросов, но даёт лучшую картину)
JIRA_FETCH_CHANGELOG=true
JIRA_FETCH_WORKLOGS=true

# ---------------------------------------------------------------------------
#  GitLab (self-hosted)
#  Personal Access Token со scope: read_api (или api), read_repository
#  Settings → Access Tokens в профиле GitLab.
# ---------------------------------------------------------------------------
GITLAB_ENABLED=true
GITLAB_BASE_URL=https://gitlab.your-company.com
GITLAB_TOKEN=
GITLAB_PAGE_SIZE=100
# true — если у инсталляции самоподписанный сертификат
GITLAB_SKIP_TLS_VERIFY=false
# Потолок числа репозиториев, по которым добираются коммиты
GITLAB_MAX_PROJECTS=200

# ---------------------------------------------------------------------------
#  Slack
#  Два режима сбора:
#   1) SLACK_USER_TOKEN (xoxp-…) со scope search:read — быстрый путь через
#      search.messages, видит все каналы, где состоит владелец токена.
#   2) SLACK_BOT_TOKEN (xoxb-…) со scopes channels:history, groups:history,
#      channels:read, groups:read, users:read, users:read.email — фолбэк
#      через обход каналов. Бот должен быть приглашён в каналы.
#  Достаточно любого из двух; если заданы оба — приоритет у user-токена.
# ---------------------------------------------------------------------------
SLACK_ENABLED=true
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
# Ограничить обход каналами (id C… или имена без #), пусто — все доступные
SLACK_CHANNELS=
SLACK_INCLUDE_REACTIONS=true
SLACK_PAGE_SIZE=200

# ---------------------------------------------------------------------------
#  Google Docs / Drive
#  GOOGLE_AUTH_MODE=service_account | oauth
#
#  service_account — рекомендуется для сервиса без интерактивного логина.
#    1. Создайте сервис-аккаунт в GCP, включите Drive API и Drive Activity API.
#    2. Скачайте JSON-ключ → GOOGLE_CREDENTIALS_FILE.
#    3. Для доступа к активности конкретного человека включите domain-wide
#       delegation в Google Workspace Admin и задайте GOOGLE_IMPERSONATE_SUBJECT
#       (email этого человека). Без impersonation сервис-аккаунт видит только
#       то, что расшарено на него самого.
#
#  oauth — ходим от имени вашего аккаунта; видно всё, к чему есть доступ у вас.
#    Refresh token получается однократно через OAuth-флоу (см. README).
# ---------------------------------------------------------------------------
GOOGLE_ENABLED=true
GOOGLE_AUTH_MODE=service_account

# --- service_account ---
GOOGLE_CREDENTIALS_FILE=./secrets/google-service-account.json
# Альтернатива файлу — сам JSON одной строкой (удобно в k8s-секретах)
GOOGLE_CREDENTIALS_JSON=
#
# GOOGLE_IMPERSONATE_SUBJECT включает domain-wide delegation.
# ЕСЛИ delegation не настроен — ОСТАВЬТЕ ПУСТЫМ. С непустым значением Google
# ответит unauthorized_client, и сбор упадёт целиком.
#
# С пустым значением сервис работает в режиме «только расшаренные документы»:
# видит ровно то, что расшарено на сам сервис-аккаунт. Его адрес лежит в поле
# client_email внутри JSON-ключа и печатается в лог при старте сбора.
GOOGLE_IMPERSONATE_SUBJECT=

# --- oauth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# false — обходить только документы, найденные по ссылкам в задачах Jira (TSD).
# true  — искать по всем документам, доступным учётке: «Мой диск»,
#         «Доступные мне» и общие диски, изменённые в выбранном периоде.
GOOGLE_SCAN_DRIVE=true

# Сузить поиск до конкретных папок (id из URL папки в Drive, через запятую).
# Пусто — весь доступный корпус.
GOOGLE_DRIVE_FOLDER_IDS=

# Потолок числа документов при расширенном поиске: по каждому найденному
# документу идёт отдельный запрос активности. Если потолок сработал, об этом
# будет написано в примечании к прогону — молча ничего не отбрасывается.
GOOGLE_MAX_DOCS=500
GOOGLE_PAGE_SIZE=100

# ---------------------------------------------------------------------------
#  Google Calendar (источник gcal) — участие во встречах.
#  Использует те же учётные данные Google, что и gdocs, но отдельный scope
#  https://www.googleapis.com/auth/calendar.readonly:
#    - service_account: добавьте scope в domain-wide delegation;
#    - oauth: перевыпустите refresh token (go run ./cmd/googleauth —
#      команда теперь запрашивает и календарь).
# ---------------------------------------------------------------------------

GCAL_ENABLED=true

# Чей календарь читать. Пусто — календарь самого сотрудника (его google_email);
# он должен быть виден учётке, которой идут запросы.
GCAL_CALENDAR_ID=

# Подстроки в названии встречи (через запятую, без учёта регистра), по которым
# событие классифицируется как собеседование (тип gcal.interview).
GCAL_INTERVIEW_MARKERS=interview,собеседование

# ---------------------------------------------------------------------------
#  Allure TestOps (источник allure) — запуски тестов, тест-кейсы, дефекты.
#  Токен: Allure → профиль → API tokens. Новые версии TestOps принимают его
#  напрямую (заголовок Api-Token); для старых коллектор сам обменяет его на
#  JWT через /api/uaa/oauth/token. Автор события сопоставляется с человеком
#  по e-mail, его локальной части или логину GitLab (под SSO они совпадают).
# ---------------------------------------------------------------------------

ALLURE_ENABLED=true
ALLURE_BASE_URL=https://allure.xtools.tv
ALLURE_TOKEN=

# Ограничить обход проектами (id или имя, через запятую). Пусто — все доступные.
ALLURE_PROJECTS=

ALLURE_PAGE_SIZE=100
# Потолок страниц пагинации на сущность в одном проекте.
ALLURE_MAX_PAGES=50

# ---------------------------------------------------------------------------
#  Овертаймы (вкладка «Нарушения») — заявки Paid: Overtime из Jira Server/DC.
#  Токен: jira.xtools.tv → профиль → Personal Access Tokens (Bearer).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
#  Performance Review и PIP — Jira DC, проект PR (тикеты «Final review» /
#  «Line manager review» с полем «Rate overall impact», «Personal Development
#  Plan» с полем Type). Колонки «PR» и «PIP» на вкладке «По системе».
#  По умолчанию берутся адрес и токен овертаймов (OVERTIME_JIRA_*).
# ---------------------------------------------------------------------------
PERF_REVIEW_ENABLED=true
#PERF_REVIEW_JIRA_URL=https://jira.xtools.tv
#PERF_REVIEW_JIRA_TOKEN=
#PERF_REVIEW_JQL=project = PR AND issuetype in ("Final review", "Line manager review", "Functional manager review", "Personal Development Plan")

OVERTIME_ENABLED=true
OVERTIME_JIRA_URL=https://jira.xtools.tv
OVERTIME_JIRA_TOKEN=

# Базовый JQL заявок; диапазон по «Start Date» дописывается автоматически.
# Поле Request Type видно не всем токенам (права JSM), поэтому по умолчанию
# фильтруем по summary: заявки называются «Paid: Overtime request for <Name>».
OVERTIME_JQL=project = VAC AND summary ~ "Paid: Overtime" AND resolution = Done

# Имена полей заявки: сотрудник и даты овертайма (включительный диапазон,
# Start Date / End Date). Без дат берётся дата создания заявки.
OVERTIME_EMPLOYEE_FIELD=Employee
OVERTIME_START_FIELD=Start Date
OVERTIME_END_FIELD=End Date

# ---------------------------------------------------------------------------
#  HRDB (Atlassian Assets / JSM Insight)
#  Список сотрудников с рабочими e-mail: из него в один клик заводится
#  человек — аккаунты во всех системах ищутся по e-mail автоматически.
#  Авторизация — те же JIRA_EMAIL / JIRA_API_TOKEN.
#
#  Workspace id: GET https://<site>.atlassian.net/rest/servicedeskapi/assets/workspace
#  Employee type id: смотрите в схеме HRDB (Assets → Object schemas).
# ---------------------------------------------------------------------------
HRDB_ENABLED=true
HRDB_WORKSPACE_ID=
HRDB_EMPLOYEE_TYPE_ID=
# id атрибутов «имя» и «рабочий e-mail»; пусто — ищутся по имени атрибута
# («Display Name» / «Work Email»)
HRDB_EMPLOYEE_NAME_ATTR=
HRDB_EMPLOYEE_EMAIL_ATTR=
# Иерархия Person: активные типы и типы бывших. В TradingView под Person (278)
# живут Employee, Contractor, Candidate, Ex-employee и Ex-contractor;
# структура (Департамент/Кластер/Юнит/Команда) — объекты типа Team (171).
HRDB_EMPLOYEE_TYPES=Employee,Contractor
HRDB_EX_EMPLOYEE_TYPES=Ex-employee,Ex-contractor
# Активная HRDB по умолчанию: cloud — новая (Atlassian Cloud Assets),
# dc — старая (Insight на jira.xtools.tv, нужен VPN). Выбор из UI настроек
# сохраняется в БД и имеет приоритет.
HRDB_MODE=cloud
HRDB_DC_URL=https://jira.xtools.tv
# Bearer-токен (PAT) старой Jira; пусто — берётся OVERTIME_JIRA_TOKEN.
HRDB_DC_TOKEN=
# objectTypeId типа Employee в схеме HRDB старой Jira.
HRDB_DC_EMPLOYEE_TYPE_ID=41
HRDB_CACHE_TTL=10m
HRDB_PAGE_SIZE=100

# ---------------------------------------------------------------------------
#  Сбор
# ---------------------------------------------------------------------------
SYNC_CONCURRENCY=4
# Сколько людей собирается одновременно при сборе команды/кластера.
# Итоговая нагрузка на внешние API ~ SYNC_CONCURRENCY × SYNC_PEOPLE_CONCURRENCY.
SYNC_PEOPLE_CONCURRENCY=3
SYNC_HTTP_TIMEOUT=45s
SYNC_RUN_TIMEOUT=30m
SYNC_MAX_RETRIES=4
SYNC_DEFAULT_LOOKBACK=720h
# Дней с хвоста уже собранного перепроверять при инкрементальном сборе (защита
# от поздних событий). Дефолт для всех систем; на каждую переопределяется в UI
# (Настройки → Перекрытие). Полную перезапись даёт галка «Перезаписать интервал».
SYNC_REPROBE_DAYS=2

# ---------------------------------------------------------------------------
#  Люди, чью активность собираем.
#  JSON-массив одной строкой либо путь к JSON-файлу (например ./people.json).
#  key — короткий уникальный идентификатор, используется в URL дашборда.
#  jira_account_id — accountId из Jira Cloud (найти: /rest/api/3/myself
#                    или в URL профиля).
#  slack_user_id   — Uxxxxxxxx (профиль → «Copy member ID»).
# ---------------------------------------------------------------------------
ACTIVITY_PEOPLE=[{"key":"adavydov","display_name":"Aleksei Davydov","email":"adavydov@tradingview.com","jira_account_id":"","gitlab_username":"adavydov","slack_user_id":"","google_email":"adavydov@tradingview.com"}]

# ---------------------------------------------------------------------------
#  Аутентификация (Google OIDC) и роли
#  Google Cloud Console → OAuth consent screen (Internal) → Credentials →
#  OAuth client ID (Web): redirect URI = <AUTH_PUBLIC_URL>/auth/callback.
#  Роли: viewer (чтение), lead (своё поддерево HRDB), supervisor (всё, кроме
#  AI/удаления/общих настроек), administrator. Управление — в общих настройках.
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_PUBLIC_URL=http://localhost:8080
AUTH_ALLOWED_DOMAIN=tradingview.com
# Случайная строка 32+ символов: openssl rand -base64 32
AUTH_COOKIE_SECRET=
# Первые администраторы (bootstrap), дальше роли раздаются в UI.
ADMIN_EMAILS=adavydov@tradingview.com
AUTH_SESSION_TTL=12h

# Ключ шифрования текстов Slack-архива (AES-256-GCM): openssl rand -base64 32
# Тексты сообщений читает только administrator по явному запросу; в ленте
# событий у всех — id сообщения и AI-оценка.
SLACK_TEXT_KEY=

# ---------------------------------------------------------------------------
#  Google Workspace audit (источник gwork) — Admin SDK Reports API.
#  Требует АДМИН-доступа: сервис-аккаунт с domain-wide delegation на
#  reports-скоупы ЛИБО OAuth-токен администратора (те же GOOGLE_* креды).
#  Reports API хранит аудит ~6 месяцев — годовой бэкфилл невозможен.
#  Выключено до получения нового скоупа и токена.
# ---------------------------------------------------------------------------
GWORK_ENABLED=false
# Способ авторизации только для gwork: service_account | oauth.
# Пусто — наследуется GOOGLE_AUTH_MODE. Нужен, когда gdocs/gcal ходят по oauth,
# а reports-скоупы делегированы только сервис-аккаунту.
GWORK_AUTH_MODE=
GWORK_MEET=true
GWORK_DRIVE=true
GWORK_LOGIN=true
GWORK_GMAIL=true
# device_sync — пассивный сигнал (телефон синкается в фоне сам), не действие
# человека; включайте осознанно.
GWORK_DEVICE=false
# Офисные подсети (CIDR/IP через запятую) — логин из них считается «из офиса».
# Также правится в общих настройках.
GWORK_OFFICE_CIDRS=
GWORK_PAGE_SIZE=1000

# ---------------------------------------------------------------------------
#  Argo CD (источник argocd) — ручные деплои. Несколько сред через ARGOCD_ENVS;
#  для каждой среды — ARGOCD_{ENV}_URL / ARGOCD_{ENV}_TOKEN (+ _INSECURE).
#  Токен: argocd account generate-token (read-only). Прод за SSO-прокси (VPN).
# ---------------------------------------------------------------------------
ARGOCD_ENABLED=false
ARGOCD_ENVS=prod,staging
ARGOCD_PROD_URL=https://argocd.k8s.xtools.tv
ARGOCD_PROD_TOKEN=
ARGOCD_STAGING_URL=https://argocd.k8s.xstaging.tv
ARGOCD_STAGING_TOKEN=

# ---------------------------------------------------------------------------
#  Zabbix (источник zabbix) — работа дежурных. Среды через ZABBIX_ENVS;
#  ZABBIX_{ENV}_URL / ZABBIX_{ENV}_TOKEN. Токен: Zabbix → Users → API tokens.
#  ВАЖНО: публичный zabbix.xtools.tv за OAuth-прокси недоступен — используйте
#  внутренний фронтенд-хост (VPN).
# ---------------------------------------------------------------------------
ZABBIX_ENABLED=false
ZABBIX_ENVS=prod,staging
ZABBIX_PROD_URL=https://zabbix-frontend.xtools.tv
ZABBIX_PROD_TOKEN=
ZABBIX_STAGING_URL=https://zabbix-frontend.xstaging.tv
ZABBIX_STAGING_TOKEN=

# ---------------------------------------------------------------------------
#  Jenkins (источник jenkins) — запуски сборок. Среды через JENKINS_ENVS;
#  JENKINS_{ENV}_URL / _USER / _TOKEN. Токен: профиль → Security → API Token.
#  Атрибуция по causes[].userId; автозапуски не в счёт.
# ---------------------------------------------------------------------------
JENKINS_ENABLED=false
JENKINS_ENVS=prod,staging
JENKINS_PROD_URL=https://jenkins.xtools.tv
JENKINS_PROD_USER=
JENKINS_PROD_TOKEN=
JENKINS_STAGING_URL=https://jenkins.xstaging.tv
JENKINS_STAGING_USER=
JENKINS_STAGING_TOKEN=
JENKINS_MAX_JOBS=300
JENKINS_BUILDS_PER_JOB=50

# ---------------------------------------------------------------------------
#  Grafana (источник grafana) — правки дашбордов и аннотации. Среды через
#  GRAFANA_ENVS; GRAFANA_{ENV}_URL / GRAFANA_{ENV}_TOKEN (+ _INSECURE).
#  Токен: Administration → Service accounts → Add service account token
#  (роль Viewer достаточно). Прод за OAuth-прокси — нужен VPN.
#  GRAFANA_MAX_DASHBOARDS — сколько дашбордов обойти; GRAFANA_VERSIONS_PER_DASH
#  — сколько последних версий смотреть у каждого.
# ---------------------------------------------------------------------------
GRAFANA_ENABLED=false
GRAFANA_ENVS=prod,staging
GRAFANA_PROD_URL=https://grafana.xtools.tv
GRAFANA_PROD_TOKEN=
GRAFANA_STAGING_URL=https://grafana.xstaging.tv
GRAFANA_STAGING_TOKEN=
GRAFANA_MAX_DASHBOARDS=500
GRAFANA_VERSIONS_PER_DASH=20

# ---------------------------------------------------------------------------
#  Figma (источник figma) — org-wide активность через Activity Logs API:
#  правки файлов, комментарии, публикации библиотек. Атрибуция по actor.email.
#  Требования: тариф Enterprise; personal access token от org-админа со
#  скоупом org:activity_log_read (заголовок X-Figma-Token). Токен обычного
#  пользователя к /v1/activity_logs доступа НЕ имеет.
#  FIGMA_MAX_PAGES — потолок страниц пагинации за один прогон (по 1000 событий).
# ---------------------------------------------------------------------------
FIGMA_ENABLED=false
FIGMA_TOKEN=
FIGMA_BASE_URL=https://api.figma.com
FIGMA_MAX_PAGES=50

# ---------------------------------------------------------------------------
#  NetSuite (netsuite) — аудит действий в ERP через SuiteQL: изменения записей
#  (SystemNote) и входы (LoginAudit). Token-Based Authentication (OAuth 1.0a).
#  Роль токена — только чтение аудита (SuiteAnalytics Connect – Read All либо
#  Reports:System Notes + Login Audit Trail). ACCOUNT_ID — realm (1234567 или
#  1234567_SB1). Хост SuiteTalk строится из ACCOUNT_ID автоматически.
# ---------------------------------------------------------------------------
NETSUITE_ENABLED=false
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_PAGE_SIZE=1000
# Действия с календарём (создание/правка/удаление встреч, управление гостями)
# из Drive-аудита воркспейса. Дополняет участие из gcal (это авторство встреч).
GWORK_CALENDAR=true

# ---------------------------------------------------------------------------
#  Claude Code (claude) — использование Claude Code, выгружаемое в S3-бакет.
#  Раскладка ключей: <PREFIX>dt=YYYY-MM-DD/<host>.jsonl, каждый объект — JSON по
#  одному человеку/машине за день (report.daily[]: запросы и токены). За день с
#  активностью создаётся событие claude.usage. Атрибуция по e-mail из записи.
#  Доступ — read-only ключ S3 (AWS Signature V4). Для AWS ENDPOINT оставить
#  пустым (virtual-hosted); для S3-совместимого (MinIO) задать ENDPOINT
#  (path-style), напр. https://s3.internal.tv.
# ---------------------------------------------------------------------------
CLAUDE_ENABLED=false
CLAUDE_S3_BUCKET=tradingview-it-claude-usage
CLAUDE_S3_PREFIX=claude-usage/
CLAUDE_S3_REGION=us-east-1
CLAUDE_S3_ENDPOINT=
CLAUDE_S3_ACCESS_KEY_ID=
CLAUDE_S3_SECRET_ACCESS_KEY=
# Только для временных креденшелов STS (иначе оставить пустым):
CLAUDE_S3_SESSION_TOKEN=
# Потолок числа dt-партиций (дней) за один прогон:
CLAUDE_MAX_DAYS=120
